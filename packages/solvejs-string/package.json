{
  "name": "@jdsalasc/solvejs-string",
  "version": "1.10.1",
  "description": "Small TypeScript string utilities for slugs, case conversion, masking, truncation, title case, and HTML cleanup in production apps.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node ./scripts/rename-cjs.mjs && node ../../scripts/build-cjs-types.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test test/*.test.mjs",
    "lint": "tsc -p tsconfig.esm.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "jdsalasc",
  "homepage": "https://github.com/jdsalasca/solvejs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdsalasca/solvejs.git"
  },
  "bugs": {
    "url": "https://github.com/jdsalasca/solvejs/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "javascript string utilities",
    "typescript string utilities",
    "slugify",
    "kebab case",
    "camel case",
    "title case",
    "strip html tags",
    "truncate string",
    "zero dependency",
    "solvejs",
    "esm",
    "commonjs",
    "nodejs",
    "typescript",
    "javascript",
    "tree-shakeable",
    "slug generator",
    "string mask",
    "case conversion",
    "text utilities"
  ]
}
