{
  "name": "@jdsalasc/solvejs-pdf",
  "version": "0.1.7",
  "description": "Zero-dependency TypeScript PDF generator with declarative components, rich styling, and a browser PDF viewer.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./viewer": {
      "types": "./dist/esm/viewer.d.ts",
      "import": "./dist/esm/viewer.js",
      "require": "./dist/cjs/viewer.cjs"
    },
    "./jsx-runtime": {
      "types": "./dist/esm/jsx-runtime.d.ts",
      "import": "./dist/esm/jsx-runtime.js",
      "require": "./dist/cjs/jsx-runtime.cjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/esm/jsx-dev-runtime.d.ts",
      "import": "./dist/esm/jsx-dev-runtime.js",
      "require": "./dist/cjs/jsx-dev-runtime.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node ./scripts/rename-cjs.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test test/*.test.mjs && npm run test:tsx",
    "test:tsx": "tsc --noEmit --strict --skipLibCheck --target ES2022 --lib ES2022,DOM --module NodeNext --moduleResolution NodeNext --jsx react-jsx --jsxImportSource @jdsalasc/solvejs-pdf test/fixtures/jsx-auto.tsx && tsc --noEmit --strict --skipLibCheck --target ES2022 --lib ES2022,DOM --module NodeNext --moduleResolution NodeNext --jsx react-jsxdev --jsxImportSource @jdsalasc/solvejs-pdf test/fixtures/jsx-dev.tsx",
    "benchmark": "node ./scripts/benchmark.mjs",
    "lint": "tsc -p tsconfig.esm.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "jdsalasc",
  "homepage": "https://github.com/jdsalasca/solvejs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdsalasca/solvejs.git"
  },
  "bugs": {
    "url": "https://github.com/jdsalasca/solvejs/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "keywords": [
    "pdf",
    "pdf generator",
    "pdf viewer",
    "typescript",
    "javascript",
    "zero dependency",
    "declarative",
    "jsx",
    "react",
    "nextjs",
    "vite",
    "browser",
    "esm",
    "commonjs",
    "solvejs"
  ]
}
