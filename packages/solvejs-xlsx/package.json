{
  "name": "@jdsalasc/solvejs-xlsx",
  "version": "0.3.2",
  "description": "Zero-dependency TypeScript XLSX reader and writer built from scratch, with declarative JSX components, rich styling, formulas, images, CSV and a metadata-rich reader.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./jsx-runtime": {
      "import": {
        "types": "./dist/esm/jsx-runtime.d.ts",
        "default": "./dist/esm/jsx-runtime.js"
      },
      "require": {
        "types": "./dist/cjs/jsx-runtime.d.cts",
        "default": "./dist/cjs/jsx-runtime.cjs"
      }
    },
    "./jsx-dev-runtime": {
      "import": {
        "types": "./dist/esm/jsx-dev-runtime.d.ts",
        "default": "./dist/esm/jsx-dev-runtime.js"
      },
      "require": {
        "types": "./dist/cjs/jsx-dev-runtime.d.cts",
        "default": "./dist/cjs/jsx-dev-runtime.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node ./scripts/rename-cjs.mjs && node ../../scripts/build-cjs-types.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test test/*.test.mjs && npm run test:tsx",
    "test:tsx": "tsc --noEmit --strict --skipLibCheck --target ES2022 --lib ES2022,DOM --module NodeNext --moduleResolution NodeNext --jsx react-jsx --jsxImportSource @jdsalasc/solvejs-xlsx test/fixtures/jsx-auto.tsx && tsc --noEmit --strict --skipLibCheck --target ES2022 --lib ES2022,DOM --module NodeNext --moduleResolution NodeNext --jsx react-jsxdev --jsxImportSource @jdsalasc/solvejs-xlsx test/fixtures/jsx-dev.tsx",
    "check:libreoffice": "node ./scripts/check-libreoffice.mjs",
    "benchmark": "node ./scripts/benchmark.mjs",
    "lint": "tsc -p tsconfig.esm.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "jdsalasc",
  "homepage": "https://jdsalasca.github.io/solvejs/live/#pkg-xlsx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdsalasca/solvejs.git"
  },
  "bugs": {
    "url": "https://github.com/jdsalasca/solvejs/issues"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {},
  "keywords": [
    "xlsx",
    "excel",
    "spreadsheet",
    "xlsx writer",
    "xlsx reader",
    "ooxml",
    "zip",
    "zero dependency",
    "typescript",
    "javascript",
    "esm",
    "commonjs",
    "nodejs",
    "browser",
    "tree-shakeable",
    "solvejs"
  ]
}
