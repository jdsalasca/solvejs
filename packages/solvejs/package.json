{
  "name": "@jdsalasc/solvejs",
  "version": "1.15.1",
  "description": "Zero-dependency TypeScript utilities for dates, validation, money, caching, HTTP, JSON, identifiers, URLs, pagination, semver, errors, env, schema, strings, lists, and objects.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node ./scripts/rename-cjs.mjs && node ../../scripts/build-cjs-types.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test test/*.test.mjs",
    "lint": "tsc -p tsconfig.lint.json --noEmit"
  },
  "dependencies": {
    "@jdsalasc/solvejs-async": "1.11.0",
    "@jdsalasc/solvejs-cache": "0.3.1",
    "@jdsalasc/solvejs-constants": "1.10.1",
    "@jdsalasc/solvejs-date": "1.11.0",
    "@jdsalasc/solvejs-env": "1.10.1",
    "@jdsalasc/solvejs-errors": "0.2.2",
    "@jdsalasc/solvejs-http": "0.3.0",
    "@jdsalasc/solvejs-id": "0.1.0",
    "@jdsalasc/solvejs-json": "0.3.0",
    "@jdsalasc/solvejs-list": "1.11.1",
    "@jdsalasc/solvejs-money": "0.3.0",
    "@jdsalasc/solvejs-numbers": "1.11.1",
    "@jdsalasc/solvejs-objects": "1.11.0",
    "@jdsalasc/solvejs-pagination": "0.2.2",
    "@jdsalasc/solvejs-pdf": "0.1.14",
    "@jdsalasc/solvejs-regex": "1.10.1",
    "@jdsalasc/solvejs-schema": "1.10.1",
    "@jdsalasc/solvejs-semver": "0.3.1",
    "@jdsalasc/solvejs-string": "1.11.0",
    "@jdsalasc/solvejs-url": "0.2.2",
    "@jdsalasc/solvejs-validators": "1.11.0",
    "@jdsalasc/solvejs-xlsx": "0.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "jdsalasc",
  "homepage": "https://jdsalasca.github.io/solvejs/live/#pkg-meta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdsalasca/solvejs.git"
  },
  "bugs": {
    "url": "https://github.com/jdsalasca/solvejs/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "javascript utility library",
    "typescript utility library",
    "zero dependency",
    "date utilities",
    "string utilities",
    "array utilities",
    "object utilities",
    "async utilities",
    "form validators",
    "regex utilities",
    "number utilities",
    "solvejs",
    "esm",
    "commonjs",
    "nodejs",
    "typescript",
    "javascript",
    "tree-shakeable",
    "utility library",
    "monorepo",
    "no dependencies",
    "uuid",
    "ulid",
    "nanoid"
  ]
}
